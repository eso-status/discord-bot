{
  "name": "@eso-status/discord-bot",
  "version": "1.0.0",
  "description": "Eso-status discord bot",
  "author": "@dov118 <contact.dov118.dev@gmail.com> (https://dov118.dev)",
  "private": false,
  "license": "MIT",
  "engineStrict": true,
  "engines": {
    "node": "24.14.0"
  },
  "bugs": {
    "url": "https://github.com/eso-status/discord-bot/issues"
  },
  "homepage": "https://github.com/eso-status/discord-bot#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:eso-status/discord-bot.git"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --runInBand --watch",
    "test:cov": "jest --runInBand --coverage --detectOpenHandles --forceExit",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --runInBand --config ./test/jest-e2e.json",
    "migration:run": "typeorm migration:run -d ./dist/config/typeorm.config.js"
  },
  "dependencies": {
    "@discord-nestjs/common": "5.3.2",
    "@discord-nestjs/core": "5.5.1",
    "@eso-status/connector": "3.0.0-dev.5",
    "@eso-status/types": "2.0.0-dev.18",
    "@nestjs/cli": "11.0.16",
    "@nestjs/common": "11.1.16",
    "@nestjs/core": "11.1.16",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/platform-express": "11.1.16",
    "@nestjs/typeorm": "11.0.0",
    "discord.js": "14.25.1",
    "@types/morgan": "1.9.10",
    "dotenv": "17.3.1",
    "moment": "2.30.1",
    "morgan": "1.10.1",
    "mysql2": "3.19.1",
    "sqlite3": "5.1.7",
    "typeorm": "0.3.28",
    "typeorm-extension": "3.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/schematics": "11.0.9",
    "@types/jest": "30.0.0",
    "eslint": "10.0.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.15.0",
    "eslint-plugin-sonarjs": "4.0.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.4.0",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "lint-staged": "16.3.3",
    "prettier": "3.8.1",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.e2e-spec\\.ts|.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "dotenv/config"
    ],
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "modulePaths": [
      "<rootDir>"
    ]
  }
}
