{
  "name": "@eso-status/discord-bot",
  "version": "1.0.1",
  "description": "Eso-status discord bot",
  "author": "@dov118 <contact.dov118.dev@gmail.com> (https://dov118.dev)",
  "private": false,
  "license": "MIT",
  "engineStrict": true,
  "engines": {
    "node": "26.13.1"
  },
  "bugs": {
    "url": "https://github.com/eso-status/discord-bot/issues"
  },
  "homepage": "https://github.com/eso-status/discord-bot#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:eso-status/discord-bot.git"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --watch",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --coverage --detectOpenHandles --forceExit",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --config ./test/jest-e2e.json",
    "migration:run": "typeorm migration:run -d ./dist/config/typeorm.config.js"
  },
  "dependencies": {
    "@eso-status/connector": "2.2.2",
    "@eso-status/types": "1.0.9",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/event-emitter": "12.0.3",
    "@nestjs/typeorm": "12.0.3",
    "discord.js": "14.28.1",
    "dotenv": "18.0.10",
    "moment": "2.31.0",
    "mysql2": "3.24.6",
    "reflect-metadata": "0.2.2",
    "typeorm": "1.1.3",
    "typeorm-extension": "4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.13",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "better-sqlite3": "12.11.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.e2e-spec\\.ts|.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "dotenv/config"
    ],
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "modulePaths": [
      "<rootDir>"
    ]
  },
  "overrides": {
    "glob@>=9.0.0 <=14.0.1": "14.0.2",
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
